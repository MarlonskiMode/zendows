#!/usr/bin/env bash
# Sets up scripts/zendows-updater on this Mac: a detached worktree at
# ~/.local/share/zendows/updater for it to build in, and a LaunchAgent (com.marlonskimode.zendows.updater)
# that keeps it running. Run it again to pick up a new copy of the updater script.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
wt=${ZENDOWS_UPDATER_WT:-$HOME/.local/share/zendows/updater}
label=com.marlonskimode.zendows.updater
plist=$HOME/Library/LaunchAgents/$label.plist
log=$HOME/.local/share/zendows/updater.log
mkdir -p "$(dirname "$log")" "$(dirname "$wt")"
git -C "$root" fetch -q origin dev
[ -d "$wt" ] || git -C "$root" worktree add -q --detach "$wt" origin/dev
git -C "$wt" checkout -q -f --detach origin/dev
# Treat what is installed now as current, so the first build waits for the next push.
[ -f "$HOME/.local/share/zendows/installed-rev" ] || git -C "$wt" rev-parse HEAD >"$HOME/.local/share/zendows/installed-rev"
cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$label</string>
<key>ProgramArguments</key><array><string>$wt/scripts/zendows-updater</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>$log</string>
<key>StandardErrorPath</key><string>$log</string>
</dict></plist>
EOF
launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$plist"
echo "$label running from $wt; log at $log"
